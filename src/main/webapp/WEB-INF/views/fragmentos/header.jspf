<%@ page pageEncoding="UTF-8" %>
<%-- Fragmento común: cabecera HTML, barra de navegación y mensaje flash.
     La página que lo incluye debe declarar el taglib "c" y definir ${titulo}
     y, opcionalmente, ${seccion} ('lista' o 'nuevo') para marcar el enlace activo. --%>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>${titulo} · Gestor de Tareas</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
          rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="${ctx}/css/estilos.css" rel="stylesheet">
</head>
<body>
<a class="visually-hidden-focusable saltar-contenido" href="#contenido">Saltar al contenido</a>

<header class="barra-principal">
    <nav class="container d-flex align-items-center justify-content-between" aria-label="Navegación principal">
        <a class="marca" href="${ctx}/tareas">
            <span class="marca-icono"><i class="bi bi-check2-square" aria-hidden="true"></i></span>
            Gestor de Tareas
        </a>
        <ul class="nav-principal">
            <li>
                <a href="${ctx}/tareas" class="${seccion == 'lista' ? 'activo' : ''}"
                   ${seccion == 'lista' ? 'aria-current="page"' : ''}>
                    <i class="bi bi-list-task" aria-hidden="true"></i><span>Tareas</span>
                </a>
            </li>
            <li>
                <a href="${ctx}/tareas?accion=nuevo" class="${seccion == 'nuevo' ? 'activo' : ''}"
                   ${seccion == 'nuevo' ? 'aria-current="page"' : ''}>
                    <i class="bi bi-plus-circle" aria-hidden="true"></i><span>Nueva tarea</span>
                </a>
            </li>
        </ul>
    </nav>
</header>

<main id="contenido" class="container py-4 py-md-5">
    <%-- Mensaje flash: se muestra una sola vez y luego se elimina de la sesión. --%>
    <c:if test="${not empty sessionScope.mensaje}">
        <c:set var="flashExito" value="${sessionScope.tipoMensaje == 'success'}"/>
        <div class="alert alerta-flash alert-${sessionScope.tipoMensaje} alert-dismissible fade show"
             role="${flashExito ? 'status' : 'alert'}" aria-live="${flashExito ? 'polite' : 'assertive'}"
             ${flashExito ? 'data-autocerrar="5000"' : ''}>
            <i class="bi ${flashExito ? 'bi-check-circle-fill' : 'bi-exclamation-octagon-fill'}" aria-hidden="true"></i>
            <span><c:out value="${sessionScope.mensaje}"/></span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar mensaje"></button>
        </div>
        <c:remove var="mensaje" scope="session"/>
        <c:remove var="tipoMensaje" scope="session"/>
    </c:if>
